# ============================================================
# Mix for a Mission — .gitignore
# This is a plain HTML/CSS/JS static site with no build step,
# so there are no node_modules/, dist/, or build artifacts to
# ignore. This file catches local dev-server byproducts and
# common OS/editor cruft so the first commit (and every push
# after) stays clean.
# ============================================================

# Local dev-server byproducts (python3 -m http.server, etc.)
server.log
server.pid
*.log
*.pid

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editor / IDE configs
.vscode/
.idea/
*.swp
*.swo
*~
